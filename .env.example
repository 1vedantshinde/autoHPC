# AutoHPC Environment Configuration Template
# Copy this file to .env and customize values for live email and ledger settings:
# cp .env.example .env

# ==============================================================================
# SMTP Email Notifications
# ==============================================================================
# For Gmail: use smtp.gmail.com, port 587, and an App Password (not your normal password)
AUTOHPC_SMTP_HOST=smtp.gmail.com
AUTOHPC_SMTP_PORT=587
AUTOHPC_SMTP_USER=your_email@gmail.com
AUTOHPC_SMTP_PASS=your_app_password
AUTOHPC_SMTP_FROM=AutoHPC RPA Bot <your_email@gmail.com>
AUTOHPC_SMTP_TO=destination@example.com

# ==============================================================================
# Webhook Notifications (Optional: Slack / Discord / Custom Endpoint)
# ==============================================================================
# AUTOHPC_WEBHOOK_URL=https://webhook.site/your-custom-uuid

# ==============================================================================
# Excel Master Ledger Path
# ==============================================================================
AUTOHPC_EXCEL_PATH=data/autohpc_master_ledger.xlsx

# ==============================================================================
# UiPath Orchestrator / Webhook Integration (Optional)
# ==============================================================================
# Option A: Direct Webhook trigger (UiPath Integration Service or Orchestrator webhook)
# UIPATH_WEBHOOK_URL=https://cloud.uipath.com/your-org/your-tenant/orchestrator_/api/hooks

# Option B: UiPath Orchestrator OData Queue Items API
# UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com/your-org/your-tenant/orchestrator_
# UIPATH_ACCESS_TOKEN=your_bearer_token_here
# UIPATH_TENANT_LOGICAL_NAME=DefaultTenant
# UIPATH_QUEUE_NAME=AutoHPC_Experiments
